---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import WorkCard from "../components/WorkCard.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";

const projects = (await getCollection("work", ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout>
  <Hero />

  <Section
    id="work"
    index="01"
    label="Selected Work"
    title="Projects worth explaining."
    intro="Three case studies covering the problem, the technical decisions behind the solution, and what actually shipped."
  >
    <div>
      {projects.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </Section>

  <Section
    id="about"
    index="02"
    label="About"
    title="Final-year student, working developer."
  >
    <About />
  </Section>

  <Section
    id="contact"
    index="03"
    label="Contact"
    title="Let's build something."
  >
    <Contact />
  </Section>
</Layout>
