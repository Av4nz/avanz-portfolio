---
import { site, nav } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  class="sticky top-0 z-50 border-b border-line/80 bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/65"
>
  <div class="mx-auto flex h-16 max-w-content items-center justify-between px-gutter">
    <a
      href="/"
      class="group flex items-baseline gap-2 font-display text-lg font-semibold tracking-tight"
      aria-label={`${site.name}, home`}
    >
      <span>{site.alias}</span>
      <span class="hidden text-sm font-normal text-fg-subtle sm:inline">{site.name}</span>
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 sm:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-md px-3 py-2 text-sm text-fg-muted transition-colors hover:text-fg"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={site.cv}
        class="mr-1 rounded-md px-3 py-2 text-sm text-fg-muted transition-colors hover:text-fg sm:mr-2"
      >
        CV
      </a>

      <ThemeToggle />
    </nav>
  </div>
</header>
