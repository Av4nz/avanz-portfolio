---
import { site, skillGroups, experience } from "../data/site";
---

<div class="grid gap-x-12 gap-y-16 md:grid-cols-12">
  {/* Bio */}
  <div class="reveal md:col-span-7">
    <div class="space-y-5 text-base leading-relaxed text-fg-muted sm:text-lg">
      {site.bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-line pt-8">
      <div>
        <dt class="label mb-2">Location</dt>
        <dd class="text-sm text-fg">{site.location}</dd>
      </div>
      <div>
        <dt class="label mb-2">Status</dt>
        <dd class="text-sm text-fg">{site.availability}</dd>
      </div>
    </dl>
  </div>

  {/* Skills */}
  <div class="reveal md:col-span-5">
    <div class="space-y-8">
      {
        skillGroups.map((group) => (
          <div>
            <h3 class="label mb-4">{group.title}</h3>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-sm border border-line bg-surface px-3 py-1.5 text-sm text-fg-muted">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  {/* Experience timeline */}
  <div class="reveal md:col-span-12">
    <h3 class="label mb-8 border-t border-line pt-8">Experience & Education</h3>
    <ol class="space-y-0">
      {
        experience.map((item) => (
          <li class="grid gap-x-12 gap-y-2 border-b border-line py-6 md:grid-cols-12">
            <p class="label pt-1 md:col-span-3">{item.period}</p>
            <div class="md:col-span-9">
              <h4 class="text-lg font-medium">
                {item.role}
                <span class="text-fg-subtle"> · {item.company}</span>
              </h4>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-fg-muted">
                {item.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</div>
